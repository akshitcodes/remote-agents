{
  "name": "@akshitcodes/remote-agents",
  "version": "0.4.4",
  "description": "Self-hosted mobile web UI for your Codex, Claude Code, and Grok CLI sessions.",
  "type": "module",
  "bin": {
    "remote-agents": "bin/codex-phone.mjs"
  },
  "main": "server.mjs",
  "scripts": {
    "start": "node bin/codex-phone.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "bin/",
    "server.mjs",
    "app-home.mjs",
    "attachments.mjs",
    "send-ledger.mjs",
    "thread-subscriptions.mjs",
    "thread-settings.mjs",
    "watch.mjs",
    "push.mjs",
    "codex-rollout.mjs",
    "codex-account.mjs",
    "dispatch-settings.mjs",
    "codex-titles.mjs",
    "recent-threads.mjs",
    "provider-detect.mjs",
    "cli-capabilities.mjs",
    "config.mjs",
    "onboarding.mjs",
    "usage-state.mjs",
    "usage-retry.mjs",
    "notification-content.mjs",
    "local-proof.mjs",
    "terminal-runner.mjs",
    "terminal-security.mjs",
    "terminal-worker.mjs",
    "pty-terminal.mjs",
    "providers/",
    "public/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@inquirer/select": "^5.2.2",
    "@simplewebauthn/server": "13.3.3",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "keywords": [
    "codex",
    "claude",
    "cli",
    "mobile",
    "remote",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshitcodes/remote-agents.git"
  },
  "homepage": "https://github.com/akshitcodes/remote-agents#readme",
  "bugs": "https://github.com/akshitcodes/remote-agents/issues",
  "license": "MIT",
  "devDependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
